# Copy to .env.local (local) or add in your host's Environment Variables (Vercel / Azure).
# Everything is optional — the app runs without any of these (progress saved in the browser).

# --- Supabase: login + sync across phone and laptop ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Anthropic: AI tutor, sentence grading, custom words, mock tests ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5

# --- Azure AI Speech: pronunciation scoring ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- Sarvam AI: meanings in Telugu/Hindi/etc. (falls back to Claude if empty) ---
SARVAM_API_KEY=

# --- Only if you deploy WITHOUT Supabase: protects your AI credits ---
APP_ACCESS_CODE=
